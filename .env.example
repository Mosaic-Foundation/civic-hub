# Copy this file to .env (which is gitignored) and fill in real values.
# Vercel: set the same vars under Project Settings → Environment Variables,
# one value per environment (Production / Preview / Development).

# --- Supabase ---
# Project URL, e.g. https://nfhyy…supabase.co
SUPABASE_URL=

# Service role SECRET key (starts with sb_secret_…). NEVER commit or expose
# to a browser. Find it in Supabase → Settings → API Keys → Secret keys.
SUPABASE_SERVICE_ROLE_KEY=

# --- Hub config ---
# Public URL the hub advertises as its API origin in events (source.hub_url)
# and the discovery manifest.
# Local dev: http://localhost:3000
# Production: https://floyd.civic.social  (or whatever your domain is)
BASE_URL=http://localhost:3000

# Public URL the hub uses when constructing user-facing action_url values
# on emitted events (per Civic Event Spec §3 — "link to take action").
# Falls back to BASE_URL if unset, which is correct for single-origin
# deployments where the UI and API share a hostname (e.g. Vercel). In
# split-origin local dev (API on :3000, UI on :5173) set this to the UI
# origin so feed posts navigate to the UI, not the JSON API.
# Local split-origin dev: http://localhost:5173
CIVIC_UI_BASE_URL=

# The space's stable identifier — a DID. Civic Activity Spec v0.2 §2.2 makes
# this `generator.id` on every emitted activity and §3.3 makes it the key a
# consumer re-binds on when the space migrates: unlike BASE_URL it never
# changes. Example: did:web:floyd.civic.social
# If unset, it is derived from the BASE_URL host (did:web:localhost%3A3000 in
# local dev), which is fine for dev and preview. In PRODUCTION the hub refuses
# to start without it (src/config/hub.ts: assertSpaceIdentityConfigured) —
# deriving it there would tie the space's identity to its address, so moving
# the deployment would silently mint a new space. Set it once and never
# change it; a new value reads to consumers as a different space.
CIVIC_SPACE_DID=

# The civic place code this hub serves — lowercase, hyphen-separated, ordered
# broadest to narrowest, per Civic Activity Spec v0.2 §2.2.2:
#   us · us-va · us-va-floyd · us-va-floyd-ward3
# It is stamped on emitted events and serialized as
# `location: { type: "Place", civic:code: ... }` on the wire; consumers filter
# on it with containment semantics (us-va contains us-va-floyd).
# NEVER encode an organization or community name here — a community that is
# not a place is identified by CIVIC_SPACE_DID instead.
# Unset, "local", "none" and "unknown" all mean "this deployment has no civic
# geography": `location` is then omitted from activities entirely (there is no
# null sentinel on the wire) and `jurisdictions` is omitted from the manifest.
# Floyd pilot value: us-va-floyd
CIVIC_JURISDICTION=

# Optional human-readable name for CIVIC_JURISDICTION, used as the `name` of
# the serialized Place. Example: Floyd County, Virginia
CIVIC_JURISDICTION_NAME=

# Port for the local dev server (defaults to 3000 if unset).
PORT=3000

# --- Security ---
# Comma-separated list of allowed Origins for CORS.
# Example (production): https://floyd.civic.social,https://civic.social
# If unset AND NODE_ENV !== "production", all origins are allowed (dev convenience).
# If unset in production, the server refuses to start.
CIVIC_ALLOWED_ORIGINS=

# Comma-separated list of admin emails. Admin routes (/admin/*) require the
# authenticated user's email to appear in this list (case-insensitive).
# If unset, all admin routes return 503 (safe-by-default — no silent admins).
# Admins can do everything Board members can (see CIVIC_BOARD_EMAILS) plus
# proposal review, brief review/approval, and delivery settings.
CIVIC_ADMIN_EMAILS=

# Fallback list of announcement authors. Slice 4.1 introduces an
# admin-managed author list stored in the hub_settings table (editable
# from Admin → Civic Briefs → Announcement authors, with per-entry labels
# like "Board member", "Planning Committee", etc.). That DB list wins
# whenever it exists.
#
# This env var is only consulted when no DB row exists yet — in which
# case each email here is authorized with the default label
# "Board member". Useful as a safety-net bootstrap on fresh deploys.
# Once an admin has saved the author list in the UI, this env var is
# effectively ignored.
#
# Admins never need to appear here; CIVIC_ADMIN_EMAILS already grants
# announcement-posting privileges (stamped as "Admin"). Case-insensitive.
CIVIC_BOARD_EMAILS=

# Node environment. Set to "production" on Vercel Production.
NODE_ENV=development

# --- Email (Resend) ---
# Resend API key (starts with re_…). Get it from resend.com → API Keys.
# If unset, the OTP is logged to console as a dev fallback (no email sent).
RESEND_API_KEY=

# The "From" header for outbound email. Must be on a domain you've
# verified in Resend (DNS records configured). Example:
#   Floyd Civic Hub <noreply@floyd.civic.social>
# If unset, defaults to the Resend sandbox sender (onboarding@resend.dev).
RESEND_FROM=

# --- Dev-only toggles ---
# When "true", /debug/seed is allowed to wipe and reseed data, and the
# ensureSeeded middleware will auto-seed an empty database on first request.
# MUST be unset (or "false") in Production.
CIVIC_ALLOW_SEED=true

# If set, accepts this value as a bypass OTP code in /auth/verify. Useful
# for local dev and preview to skip real email delivery. MUST be unset
# in Production so real verification is enforced.
CIVIC_DEMO_BYPASS_CODE=000000

# Slice 19b — selects which seed fixture loads when CIVIC_ALLOW_SEED=true
# and the processes table is empty. Default "floyd" (Green Box +
# Flock Camera votes for Floyd County). Set to "athens" on the
# civic.social demo deployment to load the same vote topics rebranded
# for the fictional Town of Athens, Virginia.
CIVIC_SEED_FIXTURE=floyd

# --- SMTP (Civic Brief delivery) ---
# When all five SMTP_* vars below are set, admin approval of a Civic Brief
# delivers the formatted brief to BOARD_RECIPIENT_EMAIL via nodemailer.
# When any of them are unset, email delivery falls back to console logging
# (visible in the server logs) and the approval flow treats delivery as
# successful. This keeps local dev runnable without SMTP credentials.
# SMTP_PORT 465 uses TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Fallback recipient list for Civic Brief delivery. Comma-separated
# multi-recipient supported. As of Slice 3 addendum, the admin UI has a
# "Delivery settings" panel under /admin/briefs that writes to the
# hub_settings table. The backend reads the DB setting first and falls
# back to this env var only if no DB row exists, so once an admin saves
# recipients in the UI this env var is effectively ignored.
BOARD_RECIPIENT_EMAIL=

# --- Daily email digest (Slice 5) ---
# Vercel Cron hits /api/internal/digest/run once per day. The endpoint
# requires an `Authorization: Bearer <CRON_SECRET>` header; Vercel Cron
# auto-injects this header from the project's CRON_SECRET env var.
# Generate with: openssl rand -hex 32
# If unset, the cron endpoint returns 401 for every request.
CRON_SECRET=

# Runtime kill-switch for the digest job. When "false", the cron
# endpoint short-circuits with { skipped: true }. Default is "true"
# when unset. Lets operators pause digests without removing the cron
# config or redeploying.
DIGEST_ENABLED=true

# HMAC-SHA256 signing secret for one-click unsubscribe links in every
# digest email. MUST persist across deploys — rotating this invalidates
# every outstanding unsubscribe link. Minimum 16 chars; generate with:
# openssl rand -hex 32
DIGEST_UNSUBSCRIBE_SECRET=

# Hub name used in the digest email subject/header and on the
# unsubscribe confirmation page. Defaults to "Floyd Civic Hub".
HUB_NAME=Floyd Civic Hub

# Physical/postal address shown in the digest email footer
# (CAN-SPAM-style compliance). A city + state is acceptable for the
# pilot — e.g. "Floyd, VA".
HUB_POSTAL_ADDRESS=Floyd, VA

# --- AI meeting summaries (Slice 6) ---
# Vercel Cron hits /api/internal/meeting-summary/run once per day. The
# endpoint discovers meetings from MEETING_SOURCE_URL, summarizes each
# new meeting via Claude, and creates a draft civic.meeting_summary
# process for admin review. Reuses CRON_SECRET (same bearer auth as the
# digest cron).

# Anthropic API key. Required. Starts with sk-ant-... . Get it from
# https://console.anthropic.com → Settings → API Keys. Expect a few
# cents per meeting processed (PDF + transcript + summarization).
# If unset, the cron endpoint returns 500.
ANTHROPIC_API_KEY=

# Anthropic model name passed to /v1/messages. Optional — defaults to a
# current Sonnet-tier model (see src/utils/anthropic.ts DEFAULT_MODEL).
# Override here to pin or upgrade. Example: claude-sonnet-4-5-20251022
ANTHROPIC_MODEL=

# YouTube API key. Currently UNUSED — transcripts are fetched via
# SUPADATA_API_KEY or SEARCHAPI_API_KEY. Reserved for a future slice
# that wants to validate video existence or pull metadata via the
# official YouTube Data API v3. Safe to leave unset.
YOUTUBE_API_KEY=

# Supadata.ai key for YouTube transcript fetching (preferred).
# Free tier: 100 credits/month — more than enough for Floyd's ~2-4
# meetings/month. Sign up at https://supadata.ai to get your key.
# Priority order: SUPADATA_API_KEY → SEARCHAPI_API_KEY → library fallback.
# Without either key on Vercel, transcripts will fail (YouTube blocks
# cloud IPs) and summaries fall back to PDF-only.
SUPADATA_API_KEY=

# SearchAPI.io key (legacy fallback). Free tier exhausted; paid plans
# start at $40/month. Kept for backwards compatibility — prefer Supadata.
SEARCHAPI_API_KEY=

# Runtime kill-switch for the meeting-summary job. When "false", the
# cron endpoint short-circuits with { skipped: true }. Default is "true"
# when unset. Lets operators pause summaries without removing the cron
# config or redeploying.
MEETING_SUMMARY_ENABLED=true

# Jurisdiction's agendas-and-minutes page. The configured
# MeetingSourceConnector fetches this URL, parses the HTML via Claude
# using MEETING_EXTRACTION_INSTRUCTIONS, and emits a structured list of
# meeting entries. If unset, the cron endpoint returns 500.
# Floyd pilot value:
#   https://www.floydcova.gov/agendas-minutes
MEETING_SOURCE_URL=https://www.floydcova.gov/agendas-minutes

# Which registered connector to use. Optional; defaults to
# "floyd-minutes-page". MVP ships this single connector; a second
# jurisdiction requires a new entry in
# src/controllers/meetingSummaryController.ts:CONNECTORS.
MEETING_CONNECTOR_ID=floyd-minutes-page

# Admin-provided natural-language guidance. Prepended verbatim to the
# Claude parsing and summarization prompts so the admin can steer
# behavior (naming conventions, format of motions, which items to
# ignore). Optional — when unset, a short built-in generic fallback
# is used. A dedicated admin UI is a future slice.
#
# Suggested starter for the Floyd Board:
#   Floyd County Board of Supervisors meetings typically begin with
#   public comment, followed by old business, new business, and
#   adjournment. Supervisors at time of writing include [list names].
#   Common topics include road paving, EMS funding, subdivision
#   ordinances, and public hearings on tax rates. When a motion is made,
#   prefer the "Motion by: / Seconded by: / Vote: ..." format in the
#   action_taken field.
MEETING_EXTRACTION_INSTRUCTIONS=

# ISO date cutoff — meetings before this date are skipped during discovery.
# Useful for excluding old backlog entries with oversized PDFs that fail
# every run. Example: 2026-01-01
MEETING_SUMMARY_CUTOFF_DATE=

# Auto-publish meeting summaries on creation (skip admin approval queue).
# Defaults to "false" (admin review required). Set to "true" to auto-publish.
MEETING_SUMMARY_AUTO_PUBLISH=false
