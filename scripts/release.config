# What scripts/release.sh releases to. Sourced by bash; every value can be
# overridden by an environment variable of the same name.
#
# The hub URLs are the deployments' own addresses: /api/health answers on any
# hub's hostname (it is hub-exempt), so either URL only has to reach the right
# Vercel project. Kept here, not in the script, so the script names no place.

# Supabase projects. The production ref is also the value
# CONFIRM_PRODUCTION_PUSH must carry (scripts/db-push.sh).
RELEASE_DEV_REF="${RELEASE_DEV_REF:-urfmvqhzmamigssqwsya}"
RELEASE_PROD_REF="${RELEASE_PROD_REF:-nfhyypwoporfggqcerli}"

# A hub on each deployment, scheme included, no trailing slash.
RELEASE_DEV_URL="${RELEASE_DEV_URL:-https://athens.dev.civic.social}"
RELEASE_PROD_URL="${RELEASE_PROD_URL:-https://floyd.civic.social}"

# The branch each deployment builds from.
RELEASE_DEV_BRANCH="${RELEASE_DEV_BRANCH:-multi-tenant}"
RELEASE_PROD_BRANCH="${RELEASE_PROD_BRANCH:-main}"

# How long to wait for Vercel to serve a pushed commit, in seconds.
RELEASE_DEPLOY_TIMEOUT="${RELEASE_DEPLOY_TIMEOUT:-600}"

# An env file per deployment holding CIVIC_TARGET_DATABASE_URL (the database
# as its owner), for scripts/load-jurisdictions.ts. A path, never the value.
# When the jurisdiction list's checksum differs from the one live, the release
# loads the list with it; if the file is missing it prints the command.
RELEASE_DEV_DB_ENV="${RELEASE_DEV_DB_ENV:-$HOME/civic-keys/dev-db.env}"
RELEASE_PROD_DB_ENV="${RELEASE_PROD_DB_ENV:-$HOME/civic-keys/prod-pg.env}"
