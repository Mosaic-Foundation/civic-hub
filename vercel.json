{
  "buildCommand": "cd ui && npm ci --include=dev --no-audit --no-fund && npm run build",
  "outputDirectory": "ui/dist",
  "installCommand": "npm ci --include=dev --no-audit --no-fund",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    },
    "api/og.ts": {
      "includeFiles": "ui/dist/index.html"
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^(start\\.civic\\.social|start\\.dev\\.civic\\.social)$"
        }
      ],
      "destination": "/start.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^(console\\.civic\\.social|console\\.dev\\.civic\\.social|console-civic-hub-dev\\.vercel\\.app)$"
        }
      ],
      "destination": "/console.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/((?!api/|api$).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|api$|assets/).*)",
      "has": [
        {
          "type": "host",
          "value": "^(start\\.civic\\.social|start\\.dev\\.civic\\.social)$"
        }
      ],
      "destination": "/start.html"
    },
    {
      "source": "/((?!api/|api$|assets/).*)",
      "has": [
        {
          "type": "host",
          "value": "^(console\\.civic\\.social|console\\.dev\\.civic\\.social|console-civic-hub-dev\\.vercel\\.app)$"
        }
      ],
      "destination": "/console.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/events",
      "destination": "/api"
    },
    {
      "source": "/activities/:id*",
      "destination": "/api"
    },
    {
      "source": "/audiences/:name*",
      "destination": "/api"
    },
    {
      "source": "/.well-known/civic.json",
      "destination": "/api"
    },
    {
      "source": "/.well-known/did.json",
      "destination": "/api"
    },
    {
      "source": "/ns",
      "destination": "/api"
    },
    {
      "source": "/process/:id/action",
      "destination": "/api"
    },
    {
      "source": "/process/:id",
      "has": [{ "type": "header", "key": "accept", "value": ".*application/(ld|activity)\\+json.*" }],
      "destination": "/api"
    },
    {
      "source": "/process/:id*",
      "destination": "/api/og"
    },
    {
      "source": "/proposal/:id*",
      "destination": "/api/og"
    },
    {
      "source": "/project/:id*",
      "destination": "/api/og"
    },
    {
      "source": "/deliberation/:id*",
      "destination": "/api/og"
    },
    {
      "source": "/brief/:id*",
      "destination": "/api/og"
    },
    {
      "source": "/vote-results/:id*",
      "destination": "/api/og"
    },
    {
      "source": "/meeting-summary/:id*",
      "destination": "/api/og"
    },
    {
      "source": "/announcement/:id*",
      "destination": "/api/og"
    },
    {
      "source": "/wordcloud/:id*",
      "destination": "/api/og"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/meeting-summary/run",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/internal/news-sync/run",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/internal/digest/run",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/internal/admin-digest/run",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/internal/vote-close/run",
      "schedule": "5,20,35,50 * * * *"
    },
    {
      "path": "/api/internal/sample-refresh/run",
      "schedule": "45 6 * * *"
    },
    {
      "path": "/api/internal/hub-exports-sweep/run",
      "schedule": "15 * * * *"
    }
  ]
}
