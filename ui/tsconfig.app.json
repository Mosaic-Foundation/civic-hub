{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    /* A plugin package's UI module (../packages/<name>/ui.tsx, ADR-014) sits
       outside ui/, so its react imports resolve to ui's own copy. */
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-router-dom": ["./node_modules/react-router-dom"],
      /* The plugin SDK's UI types, as the example package's ui.tsx imports them (../kit/sdk/ui.ts). */
      "@civic-social/plugin-sdk/ui": ["../kit/sdk/ui.ts"],
      /* Its manifest's helpers, which the UI reads too (../kit/sdk/manifest.ts). */
      "@civic-social/plugin-sdk/manifest": ["../kit/sdk/manifest.ts"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src", "../examples/*/ui.tsx", "../features/*/ui.tsx", "../features/*/ui/**/*", "../features/*/consoleView.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test"]
}
