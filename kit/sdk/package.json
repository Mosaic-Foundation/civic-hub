      "default": "./first-party.js"
    },
    "./manifest": {
      "types": "./manifest.ts",
      "default": "./manifest.js"
    },
    "./ui": "./ui.ts",
    "./host": "./host.ts",
    "./testing": "./testing.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12"
  }
}
