node_modules/
dist/
*.js.map
*.d.ts.map
# TypeScript incremental build cache — regenerated on every `tsc -b`,
# machine-specific, never belongs in git.
*.tsbuildinfo
.env
# Slice 18 — the UI's env file carries public branding defaults
# (VITE_HUB_*) and ships in the bundle. Whitelist so production
# builds get the Floyd defaults without an out-of-band setup step.
# DO NOT put secrets here — Vite exposes VITE_-prefixed vars to
# client code. Backend/server env vars belong in civic-hub/.env.
!ui/.env

# OS artifacts
.DS_Store

# TS build output for scripts/
scripts/*.js
scripts/*.d.ts

# Vite scaffolding we don't use
ui/README.md
ui/src/assets/
.vercel
.env*

# Local DB backups — may contain prod data/PII, never commit
backups/
supabase/.temp/

# Playwright failure artifacts — screenshots and traces, never committed
test-results/
playwright-report/
