    {
      "table": "events",
      "rows": "export"
    },
    {
      "table": "feedback_submissions",
      "rows": "export"
    },
    {
      "table": "hub_admin_audit_log",
      "rows": "export"
    },
    {
      "table": "hub_invites",
      "rows": "export"
    },
    {
      "table": "hub_plugins",
      "rows": "omit",
      "reason": "which packages this host's catalog let the hub install; a new hub row records every approved package of the host it lands on, and the plugin switches travel in hub_settings (ADR-014)"
    },
    {
      "table": "hub_roles",
      "rows": "omit",
      "reason": "derived by trigger from the people.* settings and the accounts, which the export carries; the import re-derives it (ADR-011)"
    },
    {
      "table": "hub_settings",
      "rows": "export"
    },
    {
      "table": "job_runs",
      "rows": "omit",
      "reason": "an operational log of this host's scheduled runs; the next host writes its own"
    },
    {
      "table": "link_previews",
      "rows": "omit",
      "reason": "a cache of other sites' metadata; the next host refetches it"
    },
    {
      "table": "process_links",
      "rows": "export"
    },
    {
