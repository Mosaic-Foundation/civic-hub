  "EXPORT_MANIFEST": [
    {
      "table": "active_vote_keys",
      "rows": "export"
    },
    {
      "table": "admin_digest_marks",
      "rows": "omit",
      "reason": "where this host's last admin digest stopped; the next host starts its own"
    },
    {
      "table": "ai_usage",
      "rows": "omit",
      "reason": "an operational record of paid model calls, for this host's daily budget"
    },
    {
      "table": "analytics_daily",
      "rows": "omit",
      "reason": "derived from the events, which the export carries; the next host's job recomputes it"
    },
    {
      "table": "analytics_period",
      "rows": "omit",
      "reason": "derived from the events and accounts, which the export carries; the next host's job recomputes it"
    },
    {
      "table": "analytics_report_keys",
      "rows": "export"
    },
    {
      "table": "analytics_report_reads",
      "rows": "export"
    },
