  "JOBS": [
    {
      "id": "meeting_summary",
      "plugin": "meeting_summary",
      "path": "/meeting-summary/run",
      "schedule": "30 11 * * *",
      "description": "Meeting discovery and summarization, per hub that configured a source"
    },
    {
      "id": "news_sync",
      "plugin": "news_sync",
      "path": "/news-sync/run",
      "schedule": "0 12 * * *",
      "description": "News feed to announcements, per hub that configured a feed",
      "deprecatedPaths": [
        "/floyd-news-sync/run"
      ]
    },
    {
      "id": "digest",
      "plugin": "digest",
      "path": "/digest/run",
      "schedule": "0 * * * *",
      "description": "Resident email digest, per hub in its own send hour"
    },
    {
      "id": "admin_digest",
      "plugin": "admin_digest",
      "path": "/admin-digest/run",
      "schedule": "30 13 * * *",
      "description": "Admin review-queue digest, per hub"
    },
    {
      "id": "vote_close",
      "plugin": null,
      "path": "/vote-close/run",
      "schedule": "5,20,35,50 * * * *",
      "description": "Close every process past its deadline (votes, proposals, conversations), per type whose plugin is on; reshuffle open votes' ballots"
    },
    {
      "id": "sample_refresh",
      "plugin": null,
      "path": "/sample-refresh/run",
      "schedule": "45 6 * * *",
      "description": "Replace demo hubs' live samples near their deadline (demo hubs only)"
    },
    {
      "id": "hub_exports_sweep",
      "scope": "platform",
      "path": "/hub-exports-sweep/run",
      "schedule": "15 * * * *",
      "description": "Delete console hub exports older than 24 hours (the audit rows stay)"
    },
    {
      "id": "analytics",
      "plugin": "analytics",
      "path": "/analytics/run",
      "schedule": "40 * * * *",
      "description": "Activity counts from the event log: the day's events and each period's residents, per hub"
    }
  ],
